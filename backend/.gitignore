# =========================================================
# Backend .gitignore — Node.js / Express / PostgreSQL
# (replaces the stub that only ignored .env)
# =========================================================

# ---------- Environment / secrets ----------
# Real .env must NEVER be committed. Commit only .env.example.
.env
.env.*
!.env.example

# ---------- Dependencies ----------
node_modules/
jspm_packages/

# ---------- Build / coverage output ----------
dist/
build/
coverage/
*.tsbuildinfo
.nyc_output/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Runtime / OS / editor cruft ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- Uploads (user-submitted files) ----------
# The uploads/ dir holds evidence photos and PDFs from AlertNow reports.
# Keep the folder structure (with a .gitkeep) so multer's destination exists,
# but never commit the uploaded files themselves.
uploads/*
!uploads/.gitkeep

# ---------- Database / dumps ----------
*.sql.gz
*.sql.bak
*.dump
pgdata/
postgres-data/

# ---------- Caches / temp ----------
.tmp/
.cache/
.parcel-cache/
.eslintcache

# ---------- Test artifacts ----------
junit.xml
test-results/
playwright-report/
.playwright/
